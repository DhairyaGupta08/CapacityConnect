# --- App Settings ---
ENVIRONMENT=development
APP_NAME="Capacity Connect"
API_PREFIX=/api
LOG_LEVEL=INFO
ENABLE_DOCS=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://capacity:capacity_dev_password@localhost:5432/capacity_connect

# --- Security ---
JWT_SECRET=super-secret-capacity-connect-jwt-token-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.uploads
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=capacity-connect
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_MB=50

# --- Frontend Base URL (for public verification links) ---
FRONTEND_BASE_URL=http://localhost:3000
RATE_LIMIT_ENABLED=true

# --- Bootstrap Seed ---
FIRST_ADMIN_EMAIL=admin@capacity-connect.example
FIRST_ADMIN_PASSWORD=AdminPassword123!
SEED_DEFAULT_PASSWORD=DemoPassword123!
